# =============================================================================
# n8n-hubspot-goal-quota-vs-actuals-variance-forecast-bot :: environment template
# -----------------------------------------------------------------------------
# Copy to .env (git-ignored) or set in your n8n host / container / secret
# manager. Every value is a PLACEHOLDER. Never commit real values, real names
# or real webhook URLs (a Slack / Teams webhook URL IS a credential).
#
# SAFE BY DEFAULT: leaving this file untouched keeps the workflow in
# SANDBOX_MODE: zero API calls, nothing posted, zero CRM updates.
# =============================================================================

# ---- n8n runtime --------------------------------------------------------------
# Required so {{ $env.X }} works. If env access is blocked the workflow falls
# back to sandbox defaults instead of failing open.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC

# ---- Safety switches (safe defaults shown) ----------------------------------
# Safe-ON: turn off only with an explicit false/0/no/off.
SANDBOX_MODE=true
DRY_RUN=true
# Safe-OFF: turn on only with an explicit true/1/yes/on.
NOTIFICATIONS_ENABLED=false
# Writes forecast-hygiene flags to deals (the only CRM write).
HUBSPOT_MUTATIONS_ENABLED=false
# Post again for a quarter + as-of date that was already posted.
FORCE_REPOST=false

# ---- Quarter & as-of -----------------------------------------------------------
# 1 = calendar year. Fiscal years are labelled by the year they end in (FY2027).
FISCAL_YEAR_START_MONTH=1
# Empty = the fiscal quarter containing AS_OF_DATE. Must be a quarter's first day.
QUARTER_START_DATE=
# YYYY-MM-DD (UTC). Empty = today. Days before this date count as elapsed.
AS_OF_DATE=

# ---- Quotas --------------------------------------------------------------------
# hubspot_goals (goal_targets) or env (QUOTA_MAP below).
QUOTA_SOURCE=hubspot_goals
# Case-insensitive substring a goal name must contain to count as quota.
GOAL_NAME_CONTAINS=quota
# ownerId:amount pairs, used when QUOTA_SOURCE=env. Synthetic placeholders shown.
QUOTA_MAP=99100001:300000,99100002:240000
HOME_CURRENCY=USD

# ---- Pipeline weighting --------------------------------------------------------
# Deal amount property. amount_in_home_currency is HubSpot's converted amount.
AMOUNT_PROPERTY=amount_in_home_currency
# hubspot (hs_deal_stage_probability) or stage_map (STAGE_WEIGHTS below).
PROBABILITY_SOURCE=hubspot
STAGE_WEIGHTS=appointmentscheduled:0.2,qualifiedtobuy:0.4,presentationscheduled:0.6,decisionmakerboughtin:0.8,contractsent:0.9
# Open deals whose close date already passed are excluded from weighting by default.
WEIGHT_PAST_DUE_PIPELINE=false
# Optional pipeline IDs to include (empty = all).
PIPELINES=

# ---- Pacing --------------------------------------------------------------------
# calendar (7-day weeks) or business (Mon-Fri, minus BUSINESS_HOLIDAYS, 5-day weeks).
PACING_BASIS=calendar
BUSINESS_HOLIDAYS=
PACING_AHEAD_THRESHOLD=1.10
PACING_ON_TRACK_THRESHOLD=0.90
PACING_AT_RISK_THRESHOLD=0.70
CRITICAL_PROJECTED_ATTAINMENT=0.75
MIN_ELAPSED_FRACTION_FOR_PACING=0.10
MIN_PIPELINE_COVERAGE=1.0

# ---- Scope & guards ------------------------------------------------------------
INCLUDED_OWNER_IDS=
EXCLUDED_OWNER_IDS=
# Posting is blocked if more than this % of deals have invalid data.
MAX_INVALID_RECORD_PCT=10

# ---- HubSpot ---------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=
# Numeric portal ID. 99000001 is the synthetic sandbox placeholder.
HUBSPOT_PORTAL_ID=99000001
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_SEARCH_PAGE_SIZE=200
HYGIENE_FLAG_PROPERTY=forecast_hygiene_flag
HYGIENE_CHECKED_AT_PROPERTY=forecast_hygiene_checked_at

# ---- Notifications ---------------------------------------------------------------
# slack, teams or slack,teams
NOTIFY_CHANNELS=slack
# Slack incoming webhook URL (secret).
SLACK_WEBHOOK_URL=
# Teams Workflows "Post to a channel when a webhook request is received" URL (secret).
TEAMS_WEBHOOK_URL=
# Webhook hosts the workflow may post to (exact host, or suffix starting with ".").
NOTIFY_ALLOWED_HOST_SUFFIXES=hooks.slack.com,.logic.azure.com,.powerplatform.com,.powerautomate.com
# name (owner first + last name) or id ("Owner 123").
REP_LABEL=name
MAX_REPS_IN_MESSAGE=25
REPORT_TITLE=Quota vs Actuals: Weekly Pacing

# ---- Webhook trigger -------------------------------------------------------------
# 16+ random characters. Header x-forecast-secret (or ?forecast_secret=).
WEBHOOK_SHARED_SECRET=

# ---- Testing ---------------------------------------------------------------------
# Pins "now" (ISO 8601) for reproducible runs.
NOW_OVERRIDE=

